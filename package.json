{
  "name": "pennywise",
  "productName": "Pennywise",
  "description": "Open any website or video in a floating window that stays on top. macOS.",
  "version": "1.0.0",
  "private": true,
  "main": "app/main.js",
  "license": "MIT",
  "author": "Kamran Ahmed <kamranahmed.se@gmail.com>",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --inspect",
    "test": "node --test test/*.test.js",
    "dist": "electron-builder --mac --arm64",
    "dist:universal": "electron-builder --mac --universal"
  },
  "build": {
    "appId": "info.kamranahmed.pennywise",
    "asar": true,
    "files": [
      "app/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "mac": {
      "category": "public.app-category.entertainment",
      "icon": "build/icon.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "identity": "-",
      "hardenedRuntime": false,
      "minimumSystemVersion": "12.0"
    },
    "protocols": [
      {
        "name": "Pennywise",
        "schemes": [
          "pennywise"
        ]
      }
    ],
    "dmg": {
      "artifactName": "Pennywise-${version}-${arch}.${ext}"
    }
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "^2.20.3"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  }
}
